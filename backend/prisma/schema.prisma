generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String  @id @default(uuid())
  email      String  @unique
  username   String
  otpSecret  String?
  verified   Boolean @default(false)
  createdAt  DateTime @default(now())
}