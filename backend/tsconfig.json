{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",          
    "moduleResolution": "NodeNext",  
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "src/prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}