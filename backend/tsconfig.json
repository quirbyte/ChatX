{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",          // This tells tsc to generate ESM (import/export)
    "moduleResolution": "NodeNext",  // This ensures imports work correctly in Node
    "outDir": "dist",
    "rootDir": "./",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}